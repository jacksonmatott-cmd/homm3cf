{
  "name": "heroes3-personal-cloudflare",
  "private": true,
  "version": "6.2.1",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test",
    "verify": "python3 scripts/verify-package.py",
    "package": "python3 scripts/package.py",
    "setup": "node scripts/setup-cloudflare.mjs",
    "set-account": "node scripts/set-account.mjs",
    "upload-game": "node scripts/upload-game.mjs",
    "deploy": "wrangler deploy",
    "prepare-upload": "node scripts/prepare-pages-upload.mjs",
    "build": "node scripts/build-web.mjs",
    "hydrate": "node scripts/hydrate-assets.mjs",
    "build:cloudflare": "npm run hydrate && npm run package",
    "check:deploy": "wrangler deploy --dry-run --outdir .local/worker-dry-run",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "esbuild": "0.28.2",
    "json5": "2.2.3",
    "playwright-core": "1.62.1",
    "wrangler": "4.158.0"
  },
  "description": "Complete Cloudflare Pages/Workers Heroes III browser site with accounts, private D1 game uploads and Crown Authority"
}
