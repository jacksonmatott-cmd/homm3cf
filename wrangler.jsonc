{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homm3cf",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "build": {
    "command": "npm run build:cloudflare"
  }
}
